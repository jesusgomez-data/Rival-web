{
  "brand": {
    "name": "RivalFit",
    "tagline": "Entrena · Compite · Domina",
    "url": "https://rivalfit.app"
  },
  "colors": {
    "primary": {
      "red":    { "value": "#EF4444", "usage": "CTAs, botones, acentos principales" },
      "accent": { "value": "#DC2626", "usage": "Hover states, sombras, logo depth" },
      "deep":   { "value": "#991B1B", "usage": "Sombras profundas, logo inner shadow" }
    },
    "backgrounds": {
      "base":   { "value": "#000000", "usage": "Fondo raíz de la aplicación" },
      "raised": { "value": "#0A0A0A", "usage": "Tarjetas y modales" },
      "card":   { "value": "#111111", "usage": "Cards de contenido" },
      "muted":  { "value": "#1F2937", "usage": "Secciones secundarias" }
    },
    "text": {
      "primary":   { "value": "#FFFFFF", "usage": "Títulos y texto principal" },
      "secondary": { "value": "#D1D5DB", "usage": "Subtítulos" },
      "muted":     { "value": "#9CA3AF", "usage": "Texto de apoyo" },
      "disabled":  { "value": "#4B5563", "usage": "Texto desactivado" }
    },
    "semantic": {
      "success": { "value": "#22C55E" },
      "warning": { "value": "#F59E0B" },
      "error":   { "value": "#EF4444" },
      "info":    { "value": "#3B82F6" }
    }
  },
  "typography": {
    "fonts": {
      "heading": {
        "family": "var(--font-heading), Arial Black, Impact, sans-serif",
        "weight": 900,
        "style": "italic",
        "transform": "uppercase",
        "tracking": "tight",
        "usage": "Títulos, nombres, scores, CTAs"
      },
      "body": {
        "family": "var(--font-sans), system-ui, sans-serif",
        "weight": "400–700",
        "usage": "Texto general, descripcciones, UI"
      },
      "mono": {
        "family": "monospace",
        "usage": "Datos técnicos, scores, timers"
      }
    },
    "scale": {
      "xs":   "10px  / 0.625rem",
      "sm":   "12px  / 0.75rem",
      "base": "14px  / 0.875rem",
      "lg":   "16px  / 1rem",
      "xl":   "20px  / 1.25rem",
      "2xl":  "24px  / 1.5rem",
      "3xl":  "30px  / 1.875rem",
      "4xl":  "36px  / 2.25rem",
      "5xl":  "48px  / 3rem",
      "hero": "64px+ / hero headings"
    }
  },
  "spacing": {
    "base": "4px",
    "scale": [4,8,12,16,20,24,32,40,48,64,80,96,128]
  },
  "radii": {
    "sm":   "8px",
    "md":   "12px",
    "lg":   "16px",
    "xl":   "24px",
    "2xl":  "32px",
    "3xl":  "40px",
    "full": "9999px"
  },
  "shadows": {
    "brand":    "0 4px 15px rgba(239,68,68,0.30)",
    "brand-lg": "0 10px 30px rgba(239,68,68,0.25)",
    "card":     "0 4px 24px rgba(0,0,0,0.40)"
  }
}
